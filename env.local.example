NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings -> API -> service_role key. Server-only, bypasses RLS.
# Needed for the LeetCode POTD cron to sync completions across all users.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any random string. Sent as `Authorization: Bearer <value>` by the cron
# caller to prove the request is legit, not a public hit on the route.
# Also gates the recruitment-tracker AI research route (server-to-server
# only, same reasoning).
CRON_SECRET=your-random-secret

# console.groq.com -> API Keys. Free tier, no credit card. Server-only,
# never expose with a NEXT_PUBLIC_ prefix. Powers the recruitment tracker's
# AI research passes (company overview + round prep) and its chat assistant.
GROQ_API_KEY=your-groq-api-key
